#!/usr/bin/env bash
# Enter: insert the emoji and close.
# Ctrl+Enter: insert it and reopen the picker with an empty search bar.
here=$(cd "$(dirname "$0")" && pwd)
list=$({
  sed -nE 's/^[0-9A-F ]+; fully-qualified +# (\S+) E[0-9.]+ (.*)$/\1 \2/p' /usr/share/unicode/emoji/emoji-test.txt
  cat "$here/symbols.txt"
})
while true; do
  sel=$(printf '%s\n' "$list" | fuzzel --dmenu --cache "$HOME/.cache/fuzzel-emoji" \
    --prompt "󰞅   " --mesg "Enter insert  ·  Ctrl+Enter insert and keep going")
  code=$?
  [ -z "$sel" ] && exit 0
  char=${sel%% *}
  printf '%s' "$char" | wl-copy
  sleep 0.15          # let focus return to the window you were typing in
  wtype -- "$char"
  [ "$code" -eq 10 ] || exit 0
done
