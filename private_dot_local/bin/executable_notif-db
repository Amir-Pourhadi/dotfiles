#!/usr/bin/env python3
"""Search and manage the local Dunst notification archive."""

import argparse
import json
import sqlite3
import sys
from contextlib import closing
from datetime import datetime, timezone
from pathlib import Path

# ---------------- Configuration ----------------

DB_PATH = Path.home() / ".local/share/dunst/notifications.db"
SQLITE_TIMEOUT = 10


# ---------------- Database ----------------

def connect() -> sqlite3.Connection:
    """Open a database connection with a bounded lock-wait time."""
    return sqlite3.connect(DB_PATH, timeout=SQLITE_TIMEOUT)


def local_datetime(value: str | None, date_format: str) -> str:
    """Convert a stored UTC timestamp into the user's local timezone."""
    if not value:
        return "Unknown time"

    try:
        timestamp = datetime.fromisoformat(value)

        # SQLite CURRENT_TIMESTAMP produces a naive UTC timestamp.
        if timestamp.tzinfo is None:
            timestamp = timestamp.replace(tzinfo=timezone.utc)

        return timestamp.astimezone().strftime(date_format)
    except (TypeError, ValueError):
        return "Unknown time"


def format_timestamp(value: str | None) -> str:
    """Return a compact timestamp for notification list entries."""
    return local_datetime(value, "%d %b %H:%M")


def format_datetime(value: str | None) -> str:
    """Return a detailed timestamp for notification details."""
    return local_datetime(value, "%Y-%m-%d %H:%M:%S %z")


# ---------------- Archive operations ----------------

def list_records() -> None:
    """Print all archived notification fields as JSON, newest first."""
    if not DB_PATH.exists():
        print("[]")
        return

    with closing(connect()) as connection:
        connection.row_factory = sqlite3.Row

        with connection:
            rows = connection.execute(
                """
                SELECT
                    id,
                    received_at,
                    dunst_id,
                    app_name,
                    desktop_entry,
                    summary,
                    body,
                    urgency,
                    category,
                    icon_path,
                    urls
                FROM notifications
                ORDER BY id DESC
                """
            ).fetchall()

    records = []

    for row in rows:
        record = dict(row)
        record["time_label"] = format_timestamp(record["received_at"])
        record["date_label"] = format_datetime(record["received_at"])
        records.append(record)

    print(json.dumps(records, ensure_ascii=False))


def delete_record(record_id: int) -> None:
    """Delete one notification by its database ID."""
    if not DB_PATH.exists():
        return

    with closing(connect()) as connection:
        with connection:
            connection.execute(
                "DELETE FROM notifications WHERE id = ?",
                (record_id,),
            )


def clear_records() -> None:
    """Delete all archived notifications without dropping the table."""
    if not DB_PATH.exists():
        return

    with closing(connect()) as connection:
        with connection:
            connection.execute("DELETE FROM notifications")


# ---------------- Command-line interface ----------------

def parse_args() -> argparse.Namespace:
    """Parse the requested archive operation."""
    parser = argparse.ArgumentParser(
        description="Manage the local Dunst notification archive."
    )

    commands = parser.add_subparsers(dest="command", required=True)

    commands.add_parser("list", help="List archived notifications")

    delete_parser = commands.add_parser(
        "delete",
        help="Delete one notification",
    )
    delete_parser.add_argument(
        "id",
        type=int,
        help="Notification database ID",
    )

    commands.add_parser("clear", help="Clear the entire archive")

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    try:
        if args.command == "list":
            list_records()
        elif args.command == "delete":
            if args.id < 1:
                raise ValueError("Notification ID must be positive.")
            delete_record(args.id)
        elif args.command == "clear":
            clear_records()

    except (OSError, sqlite3.Error, ValueError) as error:
        print(f"notif-db: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
